# Copy to .env.local for local dev. NEVER commit .env.local.

# Master qlaud key — mints per-end-user keys + reads usage.
QLAUD_MASTER_KEY=qlk_live_replace_me

# Per-visitor spend cap (USD). The widget can't override this.
END_USER_CAP_USD=1

# Default model for the widget bot.
DEFAULT_MODEL=claude-haiku-4-5

# Optional system prompt — set to give the bot a persona/scope.
SYSTEM_PROMPT="You are a helpful assistant embedded on a website. Keep answers concise and friendly."

# CORS allow-list. Comma-separated origins, or "*" for any.
ALLOWED_ORIGINS=*

# Auto-injected by Vercel when you connect a KV (Upstash Redis)
# database via the Storage tab. For local dev, run `vercel env pull`.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=
# KV_URL=
